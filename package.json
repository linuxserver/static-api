{
  "name": "lsio-static-api",
  "version": "1.0.0",
  "private": true,
  "description": "The LinuxServer.io API as a static site: JSON endpoints, OpenAPI spec and docs, refreshed by CI.",
  "type": "module",
  "engines": {
    "node": ">=24.2"
  },
  "scripts": {
    "refresh": "node src/refresh.ts",
    "build": "node src/build.ts",
    "preview": "node scripts/preview.ts",
    "test": "node --test",
    "typecheck": "tsc",
    "lint:openapi": "redocly lint openapi/openapi.yaml",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run lint:openapi && npm test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/**\""
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "marked": "^18.1.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@redocly/cli": "^2.71.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
